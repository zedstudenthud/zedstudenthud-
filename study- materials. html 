<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Study Materials | Zam Study Web</title>
  <meta name="description" content="Study materials, notes, revision resources and learning materials for Zambian students.">

  <link rel="stylesheet" href="style.css">

  <style>
    /* ==============================
       STUDY MATERIALS PAGE
       ============================== */

    .materials-hero {
      background: linear-gradient(135deg, #0d47a1, #1976d2);
      color: white;
      text-align: center;
      padding: 70px 20px;
    }

    .materials-hero h1 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .materials-hero p {
      max-width: 700px;
      margin: auto;
      font-size: 18px;
      line-height: 1.7;
    }

    .materials-container {
      max-width: 1150px;
      margin: auto;
      padding: 50px 20px;
    }

    /* SEARCH */

    .search-box {
      max-width: 700px;
      margin: 0 auto 35px;
      position: relative;
    }

    .search-box input {
      width: 100%;
      padding: 16px 20px;
      border: 1px solid #ddd;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .search-box input:focus {
      border-color: #1976d2;
    }

    /* FILTER BUTTONS */

    .filter-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 45px;
    }

    .filter-btn {
      border: none;
      background: #e9eef6;
      color: #123;
      padding: 12px 22px;
      border-radius: 25px;
      cursor: pointer;
      font-size: 15px;
      font-weight: 600;
      transition: 0.2s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: #0d47a1;
      color: white;
    }

    /* SECTION */

    .level-section {
      margin-bottom: 60px;
    }

    .level-title {
      text-align: center;
      margin-bottom: 10px;
      color: #0d47a1;
      font-size: 30px;
    }

    .level-description {
      text-align: center;
      color: #666;
      margin-bottom: 30px;
    }

    /* CARDS */

    .materials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 22px;
    }

    .material-card {
      background: white;
      border-radius: 16px;
      padding: 25px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      border: 1px solid #eee;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .material-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }

    .material-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .material-card h3 {
      margin: 5px 0 10px;
      color: #123;
    }

    .material-card p {
      color: #666;
      line-height: 1.6;
      font-size: 14px;
    }

    .material-label {
      display: inline-block;
      font-size: 12px;
      background: #e8f0fe;
      color: #0d47a1;
      padding: 5px 10px;
      border-radius: 15px;
      margin-bottom: 12px;
      font-weight: bold;
    }

    .open-btn {
      display: inline-block;
      margin-top: 15px;
      padding: 11px 18px;
      background: #0d47a1;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
    }

    .open-btn:hover {
      background: #08306f;
    }

    .coming-soon {
      background: #f5f5f5;
      color: #777;
      cursor: default;
    }

    /* UNIVERSITY FEATURE */

    .university-feature {
      background: linear-gradient(135deg, #f1f6ff, #ffffff);
      border: 1px solid #dbe7ff;
      border-radius: 18px;
      padding: 30px;
      margin-bottom: 30px;
    }

    .university-feature h3 {
      color: #0d47a1;
      margin-top: 0;
    }

    /* NO RESULTS */

    #noResults {
      display: none;
      text-align: center;
      padding: 30px;
      color: #777;
    }

    /* FOOTER */

    .materials-footer {
      background: #0d47a1;
      color: white;
      text-align: center;
      padding: 30px 20px;
      margin-top: 40px;
    }

    .materials-footer p {
      margin: 6px 0;
    }

    /* MOBILE */

    @media (max-width: 700px) {

      .materials-hero {
        padding: 55px 18px;
      }

      .materials-hero h1 {
        font-size: 32px;
      }

      .materials-hero p {
        font-size: 16px;
      }

      .materials-container {
        padding: 35px 15px;
      }

      .level-title {
        font-size: 25px;
      }

      .filter-buttons {
        gap: 8px;
      }

      .filter-btn {
        padding: 10px 16px;
        font-size: 14px;
      }
    }
  </style>
</head>

<body>

  <!-- ==============================
       NAVIGATION
       ============================== -->

  <nav class="navbar">

    <a href="index.html" class="logo">
      🎓 Zam Study Web
    </a>

    <div class="nav-links" id="navLinks">
      <a href="index.html">Home</a>
      <a href="study-materials.html" class="active">Study Materials</a>
      <a href="scholarships.html">Scholarships</a>
      <a href="tools.html">Student Tools</a>
      <a href="about.html">About</a>
      <a href="contact.html">Contact</a>
    </div>

    <button class="menu-btn" onclick="toggleMenu()">☰</button>

  </nav>


  <!-- ==============================
       HERO
       ============================== -->

  <section class="materials-hero">

    <h1>📚 Study Materials</h1>

    <p>
      Find learning materials, revision resources, notes and
      study support designed to help students in Zambia learn,
      prepare and succeed.
    </p>

  </section>


  <!-- ==============================
       MAIN CONTENT
       ============================== -->

  <main class="materials-container">

    <!-- SEARCH -->

    <div class="search-box">
      <input
        type="text"
        id="searchInput"
        placeholder="🔎 Search for a subject, grade or material..."
        onkeyup="searchMaterials()"
      >
    </div>


    <!-- FILTERS -->

    <div class="filter-buttons">

      <button class="filter-btn active" onclick="filterMaterials('all', this)">
        All
      </button>

      <button class="filter-btn" onclick="filterMaterials('primary', this)">
        🧒 Primary
      </button>

      <button class="filter-btn" onclick="filterMaterials('secondary', this)">
        🎒 Secondary
      </button>

      <button class="filter-btn" onclick="filterMaterials('university', this)">
        🎓 University
      </button>

    </div>


    <!-- ==============================
         PRIMARY
         ============================== -->

    <section class="level-section" data-section="primary">

      <h2 class="level-title">🧒 Primary School</h2>

      <p class="level-description">
        Learning resources for primary school students.
      </p>

      <div class="materials-grid">

        <div class="material-card" data-level="primary">
          <div class="material-icon">🔢</div>
          <span class="material-label">Primary</span>
          <h3>Grade 1–4</h3>
          <p>
            Basic learning resources, exercises and revision
            materials for lower primary students.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>


        <div class="material-card" data-level="primary">
          <div class="material-icon">📖</div>
          <span class="material-label">Primary</span>
          <h3>Grade 5–7</h3>
          <p>
            Revision resources and study materials for upper
            primary students.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>


        <div class="material-card" data-level="primary">
          <div class="material-icon">📝</div>
          <span class="material-label">Primary</span>
          <h3>Past Papers</h3>
          <p>
            Practice with past examination papers and prepare
            for important assessments.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>

      </div>

    </section>


    <!-- ==============================
         SECONDARY
         ============================== -->

    <section class="level-section" data-section="secondary">

      <h2 class="level-title">🎒 Secondary School</h2>

      <p class="level-description">
        Resources for junior and senior secondary students.
      </p>

      <div class="materials-grid">

        <div class="material-card" data-level="secondary">
          <div class="material-icon">📘</div>
          <span class="material-label">Secondary</span>
          <h3>Grade 8–9</h3>
          <p>
            Study materials and revision resources for junior
            secondary students.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>


        <div class="material-card" data-level="secondary">
          <div class="material-icon">📚</div>
          <span class="material-label">Secondary</span>
          <h3>Grade 10–12</h3>
          <p>
            Resources for senior secondary students preparing
            for examinations.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>


        <div class="material-card" data-level="secondary">
          <div class="material-icon">📝</div>
          <span class="material-label">Secondary</span>
          <h3>Past Papers</h3>
          <p>
            Practice examination questions and improve your
            exam preparation.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>


        <div class="material-card" data-level="secondary">
          <div class="material-icon">🔬</div>
          <span class="material-label">Secondary</span>
          <h3>Subjects</h3>
          <p>
            Mathematics, Sciences, English, Social Sciences
            and other subjects.
          </p>
          <span class="open-btn coming-soon">
            Coming Soon
          </span>
        </div>

      </div>

    </section>


    <!-- ==============================
         UNIVERSITY
         ============================== -->

    <section class="level-section" data-section="university">

      <h2 class="level-title">🎓 University</h2>

      <p class="level-description">
        Study materials for university and college students.
      </p>


      <div class="university-feature">

        <h3>📂 University Study Materials</h3>

        <p>
          This section will contain lecture notes, modules,
          quizzes, past papers and other resources uploaded
          for university students.
        </p>

        <p>
          We will gradually organise the materials by
          <strong>course, programme and subject</strong>.
        </p>

      </div>


      <div class="materials-grid">

        <div class="material-card" data-level="university">

          <div class="material-icon">🧬</div>

          <span class="material-label">University</span>

          <h3>Biology</h3>

          <p>
            Biology notes, modules, quizzes and other
            university-level learning resources.
          </p>

          <span class="open-btn coming-soon">
            Materials Coming Soon
          </span>

        </div>


        <div class="material-card" data-level="university">

          <div class="material-icon">📕</div>

          <span class="material-label">University</span>

          <h3>Lecture Notes</h3>

          <p>
            Access organised lecture notes and learning
            resources for different university programmes.
          </p>

          <span class="open-btn coming-soon">
            Coming Soon
          </span>

        </div>


        <div class="material-card" data-level="university">

          <div class="material-icon">📝</div>

          <span class="material-label">University</span>

          <h3>Past Papers</h3>

          <p>
            Practice questions and past examination papers
            to help you prepare for university exams.
          </p>

          <span class="open-btn coming-soon">
            Coming Soon
          </span>

        </div>


        <div class="material-card" data-level="university">

          <div class="material-icon">🧠</div>

          <span class="material-label">University</span>

          <h3>Quizzes & Revision</h3>

          <p>
            Test your understanding and strengthen your
            knowledge through revision resources.
          </p>

          <span class="open-btn coming-soon">
            Coming Soon
          </span>

        </div>

      </div>

    </section>


    <!-- NO RESULTS -->

    <div id="noResults">
      <h3>😕 No materials found</h3>
      <p>Try searching for another subject, grade or material.</p>
    </div>

  </main>


  <!-- ==============================
       FOOTER
       ============================== -->

  <footer class="materials-footer">

    <p><strong>🎓 Zam Study Web</strong></p>

    <p>Learn. Prepare. Succeed.</p>

    <p>
      Helping students in Zambia access useful learning resources.
    </p>

    <p>
      © 2026 Zam Study Web. All rights reserved.
    </p>

  </footer>


  <!-- ==============================
       JAVASCRIPT
       ============================== -->

  <script>

    /* MOBILE MENU */

    function toggleMenu() {

      const nav = document.getElementById("navLinks");

      nav.classList.toggle("show");

    }


    /* FILTER MATERIALS */

    function filterMaterials(level, button) {

      const cards = document.querySelectorAll(".material-card");
      const sections = document.querySelectorAll(".level-section");

      /* Remove active button */

      document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.classList.remove("active");
      });

      button.classList.add("active");


      /* Show / hide sections */

      sections.forEach(section => {

        if (level === "all") {

          section.style.display = "block";

        } else {

          if (section.dataset.section === level) {
            section.style.display = "block";
          } else {
            section.style.display = "none";
          }

        }

      });


      /* Show cards */

      cards.forEach(card => {

        if (level === "all" || card.dataset.level === level) {

          card.style.display = "block";

        } else {

          card.style.display = "none";

        }

      });

    }


    /* SEARCH MATERIALS */

    function searchMaterials() {

      const search =
        document.getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

      const cards =
        document.querySelectorAll(".material-card");

      let found = 0;


      cards.forEach(card => {

        const text = card.innerText.toLowerCase();

        if (text.includes(search)) {

          card.style.display = "block";
          found++;

        } else {

          card.style.display = "none";

        }

      });


      /* Show all sections when searching */

      document.querySelectorAll(".level-section").forEach(section => {
        section.style.display = "block";
      });


      /* No results message */

      const noResults =
        document.getElementById("noResults");

      if (found === 0 && search !== "") {

        noResults.style.display = "block";

      } else {

        noResults.style.display = "none";

      }

    }

  </script>

</body>
</html>